; INPUT FILE (Martini3 - NVT)

; GENERAL INPUT FLAGS
title                  = MD_Eq_Nvt
cpp                    = /usr/bin/cpp
define                 = -DPOSRES

; RUN FLAGS
integrator             = md
dt                     = 0.020
nsteps                 = 500000     ; corre 1.5 ns
pbc                    = xyz

; NON-BONDED INTERACTIONS FLAGS
cutoff-scheme          = Verlet
ns_type                = grid
nstlist                = 10
rlist                  = 1

vdwtype                = Cut-off
rvdw                   = 1.1

coulombtype            = PME
rcoulomb               = 1.1
epsilon_r              = 15                        
optimize_fft           = yes
fourierspacing         = 0.16               
pme-order              = 4                

; DISPERSION CORRECTION
DispCorr              = EnerPres 

; TEMPERATURE COUPLING FLAGS
tcoupl                 = V-rescale
tc-grps                = Protein Other
tau_t                  = 1.0 1.0
ref_t                  = 310 310 

; INITIAL STEP VELOCITIES FLAGS
gen_vel                = yes
gen_temp               = 310
gen_seed               = -1

; PRESSURE COUPLING FLAGS
Pcoupl                 = no

; CONSTRAINTS
constraints            = none
constraint_algorithm   = Lincs

; DISTANCE RESTRAINTS    ; None (see manual)

; OUTPUT FLAGS
nstxout                = 0
nstvout                = 0
nstlog                 = 1000
nstenergy              = 100
nstxout-compressed     = 100
compressed-x-grps      = Protein
energygrps             = 
  
